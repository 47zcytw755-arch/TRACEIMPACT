# ==============================================================================
# TRACEIMPACT CLOUD — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these environment variables in your Vercel Dashboard for Production/Preview.
#
# IMPORTANT SECURITY RULE:
# NEVER prefix server secrets with NEXT_PUBLIC_.
# NEVER commit actual secrets or credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGRESQL / SUPABASE (SERVER-ONLY)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (e.g. Supabase, Neon, AWS RDS)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Direct connection URL for migrations
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Service Role Key (SERVER-ONLY, NEVER EXPOSE TO CLIENT)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. OBJECT STORAGE (CLOUDFLARE R2 / SUPABASE STORAGE) (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Option A: Supabase Storage
SUPABASE_STORAGE_BUCKET=datasets

# Option B: Cloudflare R2 / S3-compatible
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=traceimpact-datasets
R2_PUBLIC_DOMAIN=https://assets.traceimpact.com

# ------------------------------------------------------------------------------
# 3. AI PROVIDER CONFIGURATION (DAY 4 AI CHAT ENGINE) (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Options: 'default' (zero-cost deterministic rule engine), 'gemini', or 'openai'
AI_PROVIDER=default
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY SECRETS (SERVER-ONLY)
# ------------------------------------------------------------------------------
SESSION_SECRET=generate-a-32-character-random-secret-here
COOKIE_DOMAIN=traceimpact.com

# ------------------------------------------------------------------------------
# 5. CLIENT-SAFE PUBLIC CONFIGURATION (SAFE TO EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.traceimpact.com
NEXT_PUBLIC_SITE_NAME=TraceImpact Cloud
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
